# Salin ke .env. Nilai di bawah hanya untuk mock lokal; kunci asli JANGAN masuk repo.
BPJS_CONS_ID=mock-cons
BPJS_SECRET_KEY=mock-secret
VCLAIM_USER_KEY=mock-vclaim-key
ANTREAN_USER_KEY=mock-antrean-key

# Ganti base URL ke server BPJS/SIMRS asli; klien tidak perlu diubah.
VCLAIM_BASE_URL=http://localhost:8787/vclaim-rest
ANTREAN_BASE_URL=http://localhost:8787/antreanrs
SIMRS_BASE_URL=http://localhost:8787/simrs

# 1 = response tidak dienkripsi (debugging mock saja; mock dan klien harus sama).
MOCK_PLAIN=0
# Lookup peserta lewat NIK (KTP). Bawaan: true di mock, false di klien bila kosong.
IZINKAN_LOOKUP_NIK=true
MOCK_PORT=8787

# Dashboard petugas (npm run dashboard). Ganti PIN; jangan pakai nilai contoh ini.
DASHBOARD_PIN=ganti-pin-ini
DASHBOARD_PORT=8788

# Jev (System One) lewat gateway Experiential Labs. Isi kunci HANYA di .env lokal; jangan ditempel ke chat atau log.
# Kosong = Jev dilewati (Claude lalu kata kunci). Setiap ujaran pasien = satu panggilan berbayar.
EXPERIENTIAL_API_KEY=
JEV_BATAS_WAKTU_MS=3000
